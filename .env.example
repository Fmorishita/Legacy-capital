# URL pública del sitio (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://legacycapitalmx.vercel.app

# Supabase: los leads se guardan desde el servidor (nunca desde el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Recomendado: service role (solo servidor). Alternativa: publishable/anon key + política de INSERT (ver supabase/migrations)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Secreto compartido con private.settings.lead_secret en Supabase (solo servidor)
LEADS_RPC_SECRET=

# Opcional: webhook para notificar cada lead (Make, Zapier, n8n, Slack...)
LEAD_WEBHOOK_URL=

# Opcional: medición de campañas
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=

# 1 = permitir indexación en buscadores (activar al conectar el dominio definitivo)
PERMITIR_INDEXACION=0
